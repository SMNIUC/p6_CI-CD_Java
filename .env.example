# Template for local environment variables. Copy it to `.env` and fill in your
# own local database credentials (the `.env` file itself is git-ignored):
#
#   cp .env.example .env
#
# Then load it before running the app from the command line:
#
#   set -a; source .env; set +a
#   ./gradlew bootRun
#
# These map to the ${...} placeholders in
# src/main/resources/application.properties.
#
# Note: if a value contains shell-special characters (spaces, $, `, ", (, ) ...)
# wrap it in single quotes, e.g.  SPRING_DATASOURCE_PASSWORD='my)pa$$word'
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme
